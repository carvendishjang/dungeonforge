{
  "name": "dungeonforge",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "npm run build -w apps/web",
    "start": "tsx apps/server/src/main.ts",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/core/scripts && tsc --noEmit -p apps/cli && tsc --noEmit -p apps/web && tsc --noEmit -p apps/server",
    "gen": "tsx apps/cli/src/main.ts",
    "dev": "npm run dev -w apps/web",
    "server": "tsx watch apps/server/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
